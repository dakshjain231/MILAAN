# MILAAN Environment Variables
# Copy this file to .env, fill in your own values, then start MILAAN through
# the launchers so the file is loaded once, deterministically:
#     .venv/bin/python scripts/run_app.py       # Streamlit app
#     .venv/bin/python scripts/run_webjs.py     # local WhatsApp Web demo
#     .venv/bin/python scripts/run_webhook.py   # verified status webhook
# Existing shell environment variables always win over .env, so production
# deployments should set real environment variables instead. Never commit
# real credentials; .env is gitignored.

APP_ENV=development
DATABASE_PATH=milaan.db
PORT=8501

# Production access control. APP_ENV=production enables OIDC sign-in by
# default. Configure provider secrets only in .streamlit/secrets.toml; use
# .streamlit/secrets.example.toml as the non-secret template.
MILAAN_AUTH_REQUIRED=false
# Optional comma-separated OIDC email-domain allowlist, e.g. example.com
MILAAN_ALLOWED_EMAIL_DOMAINS=

# WhatsApp Cloud API (Task 7). Real delivery is DISABLED by default.
# Leave WHATSAPP_ENABLED unset/false for simulated-only use.
# Use the exact API version and phone-number ID shown in your Meta app;
# do not guess an API version. The access token must never be committed,
# logged, pasted into the UI, or written to SQLite.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
# Optional: finite manual-retry budget per delivery record (default 3,
# maximum 5). There is no background retry scheduler.
WHATSAPP_MAX_ATTEMPTS=3

# WhatsApp webhook (verified delivery statuses + inbound replies).
# Required only if you run webhook.py. WHATSAPP_APP_SECRET is the "App
# secret" from the Meta app dashboard; WHATSAPP_VERIFY_TOKEN is a value YOU
# choose and then enter in the Meta dashboard when subscribing to the
# webhook. Never commit either. By default the webhook binds to 127.0.0.1
# and must be reached over HTTPS via a reverse proxy in production.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_PORT=8443
WHATSAPP_WEBHOOK_BIND=127.0.0.1

# WhatsApp Web local service (whatsapp-web.js) - demo/test only.
# This is separate from the Cloud API settings above. The Node service
# (whatsapp_service/) binds to localhost and stores the linked-device session
# under whatsapp_service/.wwebjs_auth (gitignored). Use the SAME long random
# MILAAN_WA_SERVICE_TOKEN (16+ characters) for this app and the service.
MILAAN_WA_ENABLED=false
MILAAN_WA_SERVICE_URL=http://127.0.0.1:8801
MILAAN_WA_SERVICE_TOKEN=
# Only this consented test number receives the demo message. The supplier
# phone number on an approved draft is never used by the demo.
MILAAN_WA_TEST_RECIPIENT=
MILAAN_WA_TIMEOUT_SECONDS=8

# Node service process settings (not read by the Python app).
MILAAN_WA_SERVICE_PORT=8801
MILAAN_WA_SERVICE_BIND=127.0.0.1
MILAAN_WA_HEADLESS=true
