# MILAAN environment template
# Copy this file to .env and fill in only what you need. Never commit .env.
# Existing shell variables always win over .env. The launchers load this file
# through scripts/env_loader.py and never print its values.
#
#   ./run_milaan.sh                     # primary UI + WhatsApp Web if enabled
#   ./run_milaan.sh --stop              # stop only what the launcher started
#   ./run_milaan.sh --with-agent        # also start the inbound agent server
#
# Primary UI: http://127.0.0.1:8501

APP_ENV=development
# Operational SQLite workspace used by the MILAAN web app.
DATABASE_PATH=milaan.db

# Access control. APP_ENV=production requires authentication: the app refuses
# to start unless both values below are set. Use HTTPS in front of the app.
# Hash: python -c "from werkzeug.security import generate_password_hash as g; print(g(input()))"
MILAAN_AUTH_REQUIRED=false
MILAAN_BASIC_AUTH_USER=
MILAAN_BASIC_AUTH_PASSWORD_HASH=
# Extra Host names the app answers for (comma separated; a leading dot allows
# subdomains). 127.0.0.1 and localhost are always allowed.
MILAAN_ALLOWED_HOSTS=
# Policy for an identity-aware proxy in front of MILAAN (not enforced by the app).
MILAAN_ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) - separate from WhatsApp Web below.
# Leave WHATSAPP_ENABLED=false for simulated/mock delivery only.
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_MAX_ATTEMPTS=3

# Verified webhook receiver (delivery statuses + inbound replies).
# Run it with: .venv/bin/python scripts/run_webhook.py
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_PORT=8443
WHATSAPP_WEBHOOK_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Local WhatsApp Web bridge (whatsapp-web.js) - QR/linked-device path.
# Localhost only. The session lives in whatsapp_service/.wwebjs_auth and is
# never included in the final ZIP. Use the same 16+ character random token
# for the Python app and the Node service.
# ---------------------------------------------------------------------------
MILAAN_WA_ENABLED=false
MILAAN_WA_SERVICE_URL=http://127.0.0.1:8801
MILAAN_WA_SERVICE_TOKEN=
# The ONLY number allowed to receive the explicit demo test message.
MILAAN_WA_TEST_RECIPIENT=
MILAAN_WA_TIMEOUT_SECONDS=8

# Real Supplier Follow-ups delivery over the bridge. With this false (the
# default) the website offers simulation only; nothing can be sent.
MILAAN_WA_LIVE_FOLLOWUPS=false
# Every number this bridge may message, comma separated. Both the Python app
# and the Node service refuse anything else, so suppliers are unreachable
# through this channel. Unset falls back to MILAAN_WA_TEST_RECIPIENT; empty
# blocks every send. A follow-up whose recipient is not listed here is
# refused with nothing sent.
MILAAN_WA_ALLOWED_RECIPIENTS=

# --- inbound documents over the same linked session ------------------------
# Files sent TO the linked WhatsApp account are imported automatically:
# a purchase register (CSV/XLSX) or a GSTR-2B export (JSON/CSV/XLSX). Once
# both halves of a tax period are present, reconciliation runs and
# supplier follow-up drafts are prepared. Importing never sends a reply, and
# a draft still needs the usual two confirmations before it can be delivered.
#
# PDFs, photos of invoices and voice notes are NOT read: there is no OCR,
# PDF text-extraction or speech-to-text service wired to this bridge. Each
# one is logged in Settings with that blocker instead of being guessed at.
MILAAN_WA_INBOUND_ENABLED=true
# Whose attachments are read. Unset falls back to MILAAN_WA_ALLOWED_RECIPIENTS
# and then to MILAAN_WA_TEST_RECIPIENT; with none of the three set, nothing is
# read at all. Messages from any other number, and every group chat, are
# ignored without being downloaded.
MILAAN_WA_INBOUND_SENDERS=
# Largest attachment the bridge will download, in bytes (max 26214400).
MILAAN_WA_INBOUND_MAX_BYTES=5242880
# Where downloaded attachments are stored (owner-only, named by content hash,
# never by the sender's file name). Defaults to ./inbound_media.
MILAAN_WA_INBOUND_DIR=

# Node service process settings.
MILAAN_WA_SERVICE_PORT=8801
MILAAN_WA_SERVICE_BIND=127.0.0.1
MILAAN_WA_HEADLESS=true

# ---------------------------------------------------------------------------
# Configuration loading
# ---------------------------------------------------------------------------
# The agent's settings loader copies this file into the process environment
# with setdefault, and it runs lazily (agent/store.py resolves its database
# path on every dashboard request). So an *unset* variable is filled in from
# here rather than staying unset: to run with a switch genuinely off, set it
# explicitly to false. MILAAN_SKIP_DOTENV=1 disables that loader completely,
# which is what tests and CI should use for a guaranteed-clean environment.
MILAAN_SKIP_DOTENV=

# ---------------------------------------------------------------------------
# Inbound agent server (Twilio or Meta webhooks) - optional.
# Start it explicitly with ./run_milaan.sh --with-agent or:
#   .venv/bin/python -m agent.server
# ---------------------------------------------------------------------------
# twilio (default) or meta. Restart the server after changing this.
WHATSAPP_PROVIDER=twilio

# Twilio WhatsApp sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VALIDATE_SIGNATURE=1
# Optional second trial account used only for supplier-side messages.
SUPPLIER_TWILIO_ACCOUNT_SID=
SUPPLIER_TWILIO_AUTH_TOKEN=
SUPPLIER_TWILIO_WHATSAPP_FROM=

# Meta Cloud API sender (alternative to Twilio).
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Public HTTPS tunnel URL (cloudflared/ngrok), no trailing slash.
PUBLIC_URL=
# Comma-separated trader phone(s) in international format.
TRADER_PHONES=
# Token required for remote access to the read-only agent dashboard.
DASHBOARD_TOKEN=
# Bind for the optional agent server. Keep 127.0.0.1 unless a deliberate
# deployment requires otherwise.
AGENT_BIND=127.0.0.1
AGENT_PORT=5050

# ---------------------------------------------------------------------------
# Agent extraction / LLM
# Any OpenAI-compatible endpoint; leave blank for offline fixtures only.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
LLM_VISION_MODEL=
GEMINI_API_KEY=

# Agent storage. Keep the agent database separate from the operational one.
# For demos/tests point this at a disposable path, e.g. /tmp/milaan-agent.db.
AGENT_DB_PATH=
AGENT_MEDIA_DIR=
EXTRACT_DOUBLE_READ=1
MAX_CHASES=3
CHASE_INTERVAL_DAYS=7
DEMO_COMMANDS=1
SEND_MODE=twilio
