# MILAAN environment template
# Copy this file to .env and fill in only what you need. Never commit .env.
# Existing shell variables always win over .env. The launchers load this file
# through scripts/env_loader.py and never print its values.
#
#   ./run_milaan.sh                     # primary UI + WhatsApp Web if enabled
#   ./run_milaan.sh --stop              # stop only what the launcher started
#   ./run_milaan.sh --with-agent        # also start the inbound agent server
#
# Primary UI: http://127.0.0.1:8501

APP_ENV=development
# Operational SQLite workspace used by the Streamlit app.
DATABASE_PATH=milaan.db

# Optional production access control. APP_ENV=production enables OIDC by
# default. Provider secrets belong in .streamlit/secrets.toml, never here.
MILAAN_AUTH_REQUIRED=false
MILAAN_ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) - separate from WhatsApp Web below.
# Leave WHATSAPP_ENABLED=false for simulated/mock delivery only.
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_MAX_ATTEMPTS=3

# Verified webhook receiver (delivery statuses + inbound replies).
# Run it with: .venv/bin/python scripts/run_webhook.py
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_PORT=8443
WHATSAPP_WEBHOOK_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Local WhatsApp Web bridge (whatsapp-web.js) - QR/linked-device demo path.
# Localhost only. The session lives in whatsapp_service/.wwebjs_auth and is
# never included in the final ZIP. Use the same 16+ character random token
# for the Python app and the Node service.
# ---------------------------------------------------------------------------
MILAAN_WA_ENABLED=false
MILAAN_WA_SERVICE_URL=http://127.0.0.1:8801
MILAAN_WA_SERVICE_TOKEN=
# The ONLY number allowed to receive the explicit demo test message.
MILAAN_WA_TEST_RECIPIENT=
MILAAN_WA_TIMEOUT_SECONDS=8

# Node service process settings.
MILAAN_WA_SERVICE_PORT=8801
MILAAN_WA_SERVICE_BIND=127.0.0.1
MILAAN_WA_HEADLESS=true

# ---------------------------------------------------------------------------
# Inbound agent server (Twilio or Meta webhooks) - optional.
# Start it explicitly with ./run_milaan.sh --with-agent or:
#   .venv/bin/python -m agent.server
# ---------------------------------------------------------------------------
# twilio (default) or meta. Restart the server after changing this.
WHATSAPP_PROVIDER=twilio

# Twilio WhatsApp sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VALIDATE_SIGNATURE=1
# Optional second trial account used only for supplier-side messages.
SUPPLIER_TWILIO_ACCOUNT_SID=
SUPPLIER_TWILIO_AUTH_TOKEN=
SUPPLIER_TWILIO_WHATSAPP_FROM=

# Meta Cloud API sender (alternative to Twilio).
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Public HTTPS tunnel URL (cloudflared/ngrok), no trailing slash.
PUBLIC_URL=
# Comma-separated trader phone(s) in international format.
TRADER_PHONES=
# Token required for remote access to the read-only agent dashboard.
DASHBOARD_TOKEN=
# Bind for the optional agent server. Keep 127.0.0.1 unless a deliberate
# deployment requires otherwise.
AGENT_BIND=127.0.0.1
AGENT_PORT=5050

# ---------------------------------------------------------------------------
# Agent extraction / LLM
# Any OpenAI-compatible endpoint; leave blank for offline fixtures only.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
LLM_VISION_MODEL=
GEMINI_API_KEY=

# Agent storage. Keep the agent database separate from the operational one.
# For demos/tests point this at a disposable path, e.g. /tmp/milaan-agent.db.
AGENT_DB_PATH=
AGENT_MEDIA_DIR=
EXTRACT_DOUBLE_READ=1
MAX_CHASES=3
CHASE_INTERVAL_DAYS=7
DEMO_COMMANDS=1
SEND_MODE=twilio
