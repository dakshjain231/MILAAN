# Agent-only environment template.
# The full MILAAN template is .env.example; use this file only when you want
# to configure the WhatsApp agent without the Streamlit workspace.
# Copy to .env and fill in locally. Never commit .env.

# LLM: any OpenAI-compatible endpoint. Leave blank for offline fixtures.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
LLM_VISION_MODEL=
GEMINI_API_KEY=

# Twilio WhatsApp sandbox / sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VALIDATE_SIGNATURE=1
SUPPLIER_TWILIO_ACCOUNT_SID=
SUPPLIER_TWILIO_AUTH_TOKEN=
SUPPLIER_TWILIO_WHATSAPP_FROM=

# Or Meta WhatsApp Cloud API.
WHATSAPP_PROVIDER=twilio
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=

PUBLIC_URL=
TRADER_PHONES=
DASHBOARD_TOKEN=
AGENT_BIND=127.0.0.1
AGENT_PORT=5050

# Keep demo/test data out of the real agent database.
AGENT_DB_PATH=
AGENT_MEDIA_DIR=
MAX_CHASES=3
CHASE_INTERVAL_DAYS=7
DEMO_COMMANDS=1
